
import random

N = 8

# Calculate attacking pairs
def heuristic(board):
    conflicts = 0

    for i in range(N):
        for j in range(i + 1, N):

            # Same row or same diagonal
            if board[i] == board[j] or abs(board[i] - board[j]) == abs(i - j):
                conflicts += 1

    return conflicts


# Print chessboard
def print_board(board):
    for row in range(N):
        for col in range(N):
            if board[col] == row:
                print("Q", end=" ")
            else:
                print(".", end=" ")
        print()


# Hill climbing algorithm
def hill_climbing():

    board = [random.randint(0, 7) for _ in range(N)]

    while True:

        current_h = heuristic(board)

        print("State:", board, "h(S):", current_h)

        if current_h == 0:
            print("\nSolution found!")
            print_board(board)
            return

        best_board = board[:]
        best_h = current_h

        # Try moving each queen
        for col in range(N):
            for row in range(N):

                new_board = board[:]
                new_board[col] = row

                new_h = heuristic(new_board)

                if new_h < best_h:
                    best_h = new_h
                    best_board = new_board

        # If no better move, restart
        if best_h >= current_h:
            print("Local minimum reached. Restarting...\n")
            board = [random.randint(0, 7) for _ in range(N)]
        else:
            board = best_board


hill_climbing()
