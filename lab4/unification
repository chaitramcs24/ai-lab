
import re

def parse(s):
    s = s.strip()

    if "(" not in s:
        return s

    name, rest = s.split("(", 1)
    rest = rest[:-1]

    args = []
    depth = 0
    start = 0

    for i, ch in enumerate(rest):
        if ch == "(":
            depth += 1
        elif ch == ")":
            depth -= 1
        elif ch == "," and depth == 0:
            args.append(parse(rest[start:i]))
            start = i + 1

    args.append(parse(rest[start:]))
    return (name, args)


def is_var(x):
    return isinstance(x, str) and x.islower()


def occurs(v, x, theta):
    x = apply(x, theta)

    if v == x:
        return True

    if isinstance(x, tuple):
        return any(occurs(v, a, theta) for a in x[1])

    return False


def apply(x, theta):
    if isinstance(x, str):
        while x in theta:
            x = theta[x]
        return x

    if isinstance(x, tuple):
        return (x[0], [apply(a, theta) for a in x[1]])

    return x


def unify(x, y, theta):
    x = apply(x, theta)
    y = apply(y, theta)

    if x == y:
        return True

    if is_var(x):
        if occurs(x, y, theta):
            return False
        theta[x] = y
        return True

    if is_var(y):
        if occurs(y, x, theta):
            return False
        theta[y] = x
        return True

    if isinstance(x, tuple) and isinstance(y, tuple):
        if x[0] != y[0] or len(x[1]) != len(y[1]):
            return False

        for a, b in zip(x[1], y[1]):
            if not unify(a, b, theta):
                return False

        return True

    return False


def test(a, b):
    theta = {}

    result = unify(parse(a), parse(b), theta)

    if result:
        print("MGU:", theta)
    else:
        print("Unification fails")



test("Knows(x,y)", "Knows(Ram,Sita)")


test("P(f(x),y)", "P(f(Ram),Sita)")


test("P(x,x)", "P(Ram,u)")


test("P(f(x),q(y))", "P(f(Ram),q(Sita))")


test("P(x)", "P(f(x))")
